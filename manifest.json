{
  "manifest_version": 3,
  "name": "Browser Pasting Tool",
  "version": "0.1.0",
  "description": "Type pasted text into the focused location after a 3-second countdown.",
  "permissions": ["activeTab"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Browser Pasting Tool",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "browser-pasting-tool@panadodev"
    }
  }
}
